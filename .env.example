# ROOT .ENV.EXAMPLE - Hardhat / Blockchain Configuration
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.

# Ethereum Wallet Private Key (use a dedicated test wallet only)
PRIVATE_KEY=your_metamask_private_key_here

# Sepolia Testnet RPC URL from Alchemy or Infura
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/your_api_key_here

# Etherscan API Key for contract verification
ETHERSCAN_API_KEY=your_etherscan_api_key_here
